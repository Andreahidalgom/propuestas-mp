<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Bitácora de restaurantes — Valdivia</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<style>
  :root{
    --teal-900:#0E2E2D;
    --teal-700:#1D5450;
    --teal-600:#2A6B65;
    --rust-500:#C1673A;
    --rust-600:#A85429;
    --paper-100:#F3EEE1;
    --paper-200:#EAE3D2;
    --ink-900:#1B1B16;
    --ink-600:#5B5B4E;
    --line:#D9D0BA;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper-100);
    color:var(--ink-900);
    font-family:'IBM Plex Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .app{
    display:flex;
    min-height:100vh;
  }
  .sidebar{
    width:340px;
    flex-shrink:0;
    background:var(--teal-900);
    color:var(--paper-100);
    display:flex;
    flex-direction:column;
    padding:28px 22px;
  }
  .brand{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:22px;
    line-height:1.15;
    margin:0 0 4px 0;
    letter-spacing:0.2px;
  }
  .brand-sub{
    font-size:13px;
    color:#AFC7C3;
    margin:0 0 22px 0;
  }
  .search{
    width:100%;
    padding:10px 12px;
    border-radius:2px;
    border:1px solid #2E5A56;
    background:#123B39;
    color:var(--paper-100);
    font-family:'IBM Plex Sans', sans-serif;
    font-size:14px;
    outline:none;
  }
  .search::placeholder{color:#7FA09B;}
  .search:focus{border-color:var(--rust-500);}
  .add-btn{
    margin-top:10px;
    width:100%;
    padding:10px 12px;
    border-radius:2px;
    border:1px dashed #3A6864;
    background:transparent;
    color:#CBDAD7;
    font-size:13px;
    cursor:pointer;
    text-align:left;
  }
  .add-btn:hover{border-color:var(--rust-500); color:var(--paper-100);}
  .list{
    margin-top:18px;
    overflow-y:auto;
    flex:1;
  }
  .list-count{
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:#7FA09B;
    margin-bottom:8px;
  }
  .item{
    display:flex;
    align-items:baseline;
    gap:8px;
    padding:10px 4px;
    border-bottom:1px solid #1B4643;
    cursor:pointer;
  }
  .item:hover .item-name{color:#FFFFFF;}
  .item.active{background:#123B39;}
  .item.active .item-name{color:var(--paper-100); font-weight:500;}
  .dot{
    width:7px; height:7px; border-radius:50%;
    flex-shrink:0;
    margin-top:5px;
  }
  .dot.done{background:#6FCF97;}
  .dot.pending{background:var(--rust-500);}
  .item-name{
    font-size:14.5px;
    color:#C9D6D3;
    line-height:1.3;
  }
  .main{
    flex:1;
    padding:44px 56px;
    max-width:760px;
  }
  .empty-state{
    color:var(--ink-600);
    font-size:15px;
    max-width:420px;
    margin-top:80px;
  }
  .empty-state h2{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:24px;
    color:var(--ink-900);
    margin-bottom:8px;
  }
  h1.rname{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:34px;
    margin:0 0 6px 0;
    line-height:1.1;
  }
  .rmeta{
    color:var(--ink-600);
    font-size:14px;
    margin-bottom:28px;
    line-height:1.6;
  }
  .rmeta a{color:var(--teal-700); text-decoration:none;}
  .section-label{
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:0.07em;
    color:var(--ink-600);
    margin-bottom:10px;
    display:block;
  }
  .field-row{
    display:flex;
    gap:24px;
    margin-bottom:30px;
    padding-bottom:26px;
    border-bottom:1px solid var(--line);
  }
  .field{flex:1;}
  .field label{
    display:block;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--ink-600);
    margin-bottom:8px;
  }
  input[type=text].rut-input{
    width:100%;
    padding:10px 12px;
    border:1px solid var(--line);
    border-radius:2px;
    background:#fff;
    font-family:'IBM Plex Mono', monospace;
    font-size:15px;
    color:var(--ink-900);
    outline:none;
  }
  input[type=text].rut-input:focus{border-color:var(--teal-700);}
  select.exec-select{
    width:100%;
    padding:10px 12px;
    border:1px solid var(--line);
    border-radius:2px;
    background:#fff;
    font-family:'IBM Plex Sans', sans-serif;
    font-size:14.5px;
    color:var(--ink-900);
    outline:none;
    cursor:pointer;
  }
  select.exec-select:focus{border-color:var(--teal-700);}
  .save-hint{
    font-size:12px;
    color:#7A9A94;
    margin-top:8px;
    height:14px;
  }
  .obs-list{
    display:flex;
    flex-direction:column;
    gap:16px;
    margin-bottom:26px;
  }
  .obs-item{
    padding-left:16px;
    border-left:2px solid var(--rust-500);
  }
  .obs-date{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:var(--ink-600);
  }
  .obs-author{
    font-weight:600;
    color:var(--teal-700);
  }
  .obs-text{
    font-size:14.5px;
    margin-top:4px;
    line-height:1.5;
    white-space:pre-wrap;
  }
  .no-obs{
    color:var(--ink-600);
    font-size:14px;
    font-style:italic;
    margin-bottom:20px;
  }
  textarea.new-obs{
    width:100%;
    min-height:70px;
    padding:12px;
    border:1px solid var(--line);
    border-radius:2px;
    font-family:'IBM Plex Sans', sans-serif;
    font-size:14.5px;
    resize:vertical;
    outline:none;
    box-sizing:border-box;
  }
  textarea.new-obs:focus{border-color:var(--teal-700);}
  .obs-submit-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:10px;
  }
  .btn-primary{
    background:var(--teal-900);
    color:var(--paper-100);
    border:none;
    padding:10px 18px;
    border-radius:2px;
    font-size:13.5px;
    cursor:pointer;
  }
  .btn-primary:hover{background:var(--teal-700);}
  .btn-primary:disabled{background:#B9B9AE; cursor:not-allowed;}
  .as-note{font-size:12px; color:var(--ink-600);}
  .modal-backdrop{
    position:fixed; inset:0; background:rgba(14,46,45,0.45);
    display:flex; align-items:center; justify-content:center;
    z-index:10;
  }
  .modal{
    background:var(--paper-100);
    padding:28px;
    width:380px;
    border-radius:2px;
  }
  .modal h3{
    font-family:'Fraunces', serif;
    font-weight:500;
    margin:0 0 16px 0;
    font-size:20px;
  }
  .modal input{
    width:100%;
    padding:9px 11px;
    margin-bottom:12px;
    border:1px solid var(--line);
    border-radius:2px;
    font-family:'IBM Plex Sans', sans-serif;
    font-size:14px;
    box-sizing:border-box;
  }
  .modal-actions{
    display:flex;
    gap:10px;
    justify-content:flex-end;
    margin-top:6px;
  }
  .btn-ghost{
    background:transparent;
    border:1px solid var(--line);
    padding:9px 16px;
    border-radius:2px;
    font-size:13.5px;
    cursor:pointer;
    color:var(--ink-900);
  }
  .load-msg{
    padding:60px;
    color:var(--ink-600);
    font-size:14px;
  }
  .visited-banner{
    display:flex;
    align-items:flex-start;
    gap:10px;
    background:#FBF0E6;
    border:1px solid #E3B98D;
    border-left:3px solid var(--rust-500);
    padding:12px 14px;
    border-radius:2px;
    margin-bottom:24px;
    font-size:13.5px;
    color:#6B4321;
    line-height:1.5;
  }
  .map-wrap{
    margin-bottom:8px;
  }
  #map-container{
    width:100%;
    height:200px;
    border-radius:2px;
    border:1px solid var(--line);
  }
  .no-map{
    font-size:13px;
    color:var(--ink-600);
    padding:14px;
    border:1px dashed var(--line);
    border-radius:2px;
    text-align:center;
    margin-bottom:8px;
  }
  .geo-btn{
    background:transparent;
    border:1px solid var(--teal-700);
    color:var(--teal-700);
    padding:7px 12px;
    border-radius:2px;
    font-size:12.5px;
    cursor:pointer;
  }
  .geo-btn:hover{background:var(--teal-700); color:#fff;}
  .geo-status{
    font-size:12px;
    color:var(--ink-600);
    margin-top:6px;
  }
  .loc-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:8px;
  }
  .notif-bar{
    background:var(--rust-600);
    color:#FFF3E9;
    padding:12px 24px;
    font-size:13.5px;
    display:flex;
    flex-direction:column;
    gap:8px;
  }
  .notif-title{
    font-weight:600;
    letter-spacing:0.02em;
  }
  .notif-item{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    background:rgba(255,255,255,0.12);
    padding:7px 12px;
    border-radius:2px;
  }
  .notif-item-text strong{font-weight:600;}
  .notif-done-btn{
    background:#fff;
    color:var(--rust-600);
    border:none;
    padding:5px 10px;
    border-radius:2px;
    font-size:12px;
    cursor:pointer;
    white-space:nowrap;
  }
  .notif-done-btn:hover{background:#FFF3E9;}
  .cal-badge{
    font-size:11px;
    padding:1px 6px;
    border-radius:8px;
    flex-shrink:0;
  }
  .cal-badge.overdue{background:#D9534F; color:#fff;}
  .cal-badge.today{background:var(--rust-500); color:#fff;}
  .cal-badge.soon{background:#3A6864; color:#EAF3F1;}
  .next-contact-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-top:6px;
  }
  input[type=date].next-date-input{
    padding:9px 10px;
    border:1px solid var(--line);
    border-radius:2px;
    font-family:'IBM Plex Sans', sans-serif;
    font-size:14px;
    background:#fff;
    outline:none;
  }
  input[type=date].next-date-input:focus{border-color:var(--teal-700);}
  .mark-done-btn{
    background:transparent;
    border:1px solid var(--teal-700);
    color:var(--teal-700);
    padding:8px 12px;
    border-radius:2px;
    font-size:12.5px;
    cursor:pointer;
  }
  .mark-done-btn:hover{background:var(--teal-700); color:#fff;}
  .notif-enable-btn{
    background:#fff;
    color:var(--rust-600);
    border:1px solid #fff;
    padding:6px 12px;
    border-radius:2px;
    font-size:12px;
    cursor:pointer;
    align-self:flex-start;
  }
  .notif-enable-btn:hover{background:#FFF3E9;}
  .notif-status{
    font-size:12px;
    opacity:0.9;
  }
  .notif-bar.stale{
    background:var(--teal-900);
    color:#DCEAE7;
  }
  .notif-bar.stale .notif-item{
    background:rgba(255,255,255,0.08);
  }
  .notif-bar.stale .notif-done-btn{
    background:#fff;
    color:var(--teal-900);
  }
  .notif-bar.stale .notif-enable-btn{
    color:var(--teal-900);
  }
  .badge-group{
    margin-left:auto;
    display:flex;
    align-items:center;
    gap:6px;
    flex-shrink:0;
  }
  .stale-badge{
    font-size:10.5px;
    color:#7A9A94;
    white-space:nowrap;
  }
</style>
</head>
<body>

<div id="root" class="load-msg">Cargando bitácora…</div>

<script>
const EJECUTIVOS = ["Iván Nahuelpan", "Carla Olguín", "Hernán Pineda", "Danilo Santana", "Andrea Hidalgo"];
const STORAGE_KEY = "restaurantes-valdivia-v1";

const SEED = [
  { name: "Mesa Incógnita Restaurant", address: "O'Higgins 210, Valdivia", phone: "+56 9 4901 1435", lat: -39.81106, lon: -73.245296 },
  { name: "La Cervecería Kunstmann", address: "Ruta T 350 950, Valdivia", phone: "+56 9 4242 7058", lat: -39.836499, lon: -73.278282 },
  { name: "Mercato", address: "Av. Los Robles 100, Valdivia", phone: "+56 63 262 5346", lat: -39.810871, lon: -73.252003 },
  { name: "Entrebrasas", address: "Carlos Anwandter, Valdivia", phone: "+56 63 228 0955", lat: -39.809617, lon: -73.244728 },
  { name: "Café Haussmann Isla Teja", address: "Av. Los Robles 202, Valdivia", phone: "+56 63 222 2100", lat: -39.810535, lon: -73.253660 },
  { name: "Fogón Sureño", address: "Janequeo 382, Valdivia", phone: "+56 63 222 9222", lat: -39.811008, lon: -73.243586 },
  { name: "Parrilla de Thor", address: "Av. Arturo Prat 653, Valdivia", phone: "+56 63 224 0401", lat: -39.811516, lon: -73.239264 },
  { name: "Botánica Bar & Restaurant", address: "Los Lingues 950, Valdivia", phone: "+56 9 3001 0887", lat: -39.815245, lon: -73.261114 },
  { name: "Magia Mar", address: "Yungay, Valdivia", phone: "+56 9 5637 5375", lat: -39.812925, lon: -73.247627 },
  { name: "The Bunker", address: "Av. Los Robles 1345, Valdivia", phone: "+56 9 7868 5929", lat: -39.810683, lon: -73.255221 },
  { name: "Restaurante La Calesa", address: "Av. Pedro Montt 2501, Valdivia", phone: "+56 9 9099 9232", lat: -39.836900, lon: -73.234350 },
  { name: "Fusión 640 Gastrobar", address: "Av. Alemania 640, Valdivia", phone: "+56 63 220 4002", lat: -39.812754, lon: -73.240089 },
  { name: "Dominga Bistro", address: "Av. Benjamín Viel s/n, Valdivia", phone: "+56 9 4149 0899", lat: -39.809034, lon: -73.248181 },
].map((r, i) => ({
  id: "seed-" + i,
  name: r.name,
  address: r.address,
  phone: r.phone,
  lat: r.lat,
  lon: r.lon,
  rut: "",
  ejecutivo: "",
  proximaFecha: "",
  proximaNota: "",
  observaciones: []
}));

function uid(){ return 'r-' + Date.now() + '-' + Math.floor(Math.random()*10000); }

function fmtDate(d){
  const dt = new Date(d);
  return dt.toLocaleDateString('es-CL', { day:'2-digit', month:'2-digit', year:'numeric' }) + ' ' +
         dt.toLocaleTimeString('es-CL', { hour:'2-digit', minute:'2-digit' });
}

let state = {
  restaurants: [],
  selectedId: null,
  search: "",
  loaded: false,
  showAddModal: false,
  showConfirmModal: false,
  geoStatus: "",
  notifPermission: ("Notification" in window) ? Notification.permission : "unsupported"
};
let pendingObsText = "";
let mapInstance = null;
const notifiedToday = new Set();
const notifiedStale = new Set();

async function loadData(){
  try {
    const result = await window.storage.get(STORAGE_KEY, true);
    if (result && result.value) {
      state.restaurants = JSON.parse(result.value);
    } else {
      state.restaurants = SEED;
      await persist();
    }
  } catch (e) {
    console.error("Error cargando datos:", e);
    state.restaurants = SEED;
  }
  state.loaded = true;
  if (state.restaurants.length) state.selectedId = state.restaurants[0].id;
  if (state.notifPermission === "granted"){
    tryNativeNotification(getDueRestaurants());
    tryStaleNotification(getStaleRestaurants());
  }
  startReminderPolling();
  render();
}

let saving = false;
async function persist(){
  try {
    saving = true;
    const res = await window.storage.set(STORAGE_KEY, JSON.stringify(state.restaurants), true);
    saving = false;
    if (!res) console.error("No se pudo guardar (respuesta vacía).");
  } catch (e) {
    saving = false;
    console.error("Error guardando:", e);
  }
}

function getSelected(){
  return state.restaurants.find(r => r.id === state.selectedId) || null;
}

function selectRestaurant(id){
  state.selectedId = id;
  render();
}

function updateField(id, field, value){
  const r = state.restaurants.find(x => x.id === id);
  if (!r) return;
  r[field] = value;
}

async function saveDetail(id){
  await persist();
  const hint = document.getElementById('save-hint-' + id);
  if (hint) { hint.textContent = "Guardado ✓"; setTimeout(() => { if(hint) hint.textContent=""; }, 1800); }
}

async function saveNextContact(id){
  await persist();
  render();
}

function attemptAddObservation(id){
  const ta = document.getElementById('new-obs-text');
  const text = ta.value.trim();
  if (!text) return;
  pendingObsText = text;
  const r = state.restaurants.find(x => x.id === id);
  if (!r) return;
  const obs = r.observaciones || [];
  const author = r.ejecutivo || "Sin asignar";
  const lastByOther = obs.find(o => o.autor !== author);
  if (lastByOther) {
    state.showConfirmModal = true;
    state.confirmTargetId = id;
    state.confirmLastAutor = lastByOther.autor;
    state.confirmLastFecha = lastByOther.fecha;
    render();
  } else {
    commitObservation(id, text);
  }
}

async function commitObservation(id, text){
  const r = state.restaurants.find(x => x.id === id);
  if (!r) return;
  const author = r.ejecutivo || "Sin asignar";
  r.observaciones = r.observaciones || [];
  r.observaciones.unshift({ fecha: new Date().toISOString(), autor: author, texto: text });
  pendingObsText = "";
  await persist();
  render();
}

function confirmAddAnyway(){
  const id = state.confirmTargetId;
  const text = pendingObsText;
  state.showConfirmModal = false;
  commitObservation(id, text);
}

function confirmCancelAdd(){
  state.showConfirmModal = false;
  pendingObsText = "";
  render();
}

function captureLocation(id){
  if (!navigator.geolocation){
    state.geoStatus = "Este navegador no soporta geolocalización.";
    render();
    return;
  }
  state.geoStatus = "Obteniendo ubicación…";
  render();
  navigator.geolocation.getCurrentPosition(
    async (pos) => {
      const r = state.restaurants.find(x => x.id === id);
      if (r){
        r.lat = pos.coords.latitude;
        r.lon = pos.coords.longitude;
        await persist();
      }
      state.geoStatus = "Ubicación guardada ✓";
      render();
    },
    (err) => {
      state.geoStatus = "No se pudo obtener tu ubicación (revisa los permisos de ubicación del navegador). " + (err && err.message ? err.message : "");
      render();
    },
    { enableHighAccuracy: true, timeout: 10000 }
  );
}

function dueStatus(fecha){
  if (!fecha) return null;
  const today = new Date(); today.setHours(0,0,0,0);
  const d = new Date(fecha + 'T00:00:00');
  const diffDays = Math.round((d - today) / 86400000);
  if (diffDays < 0) return 'overdue';
  if (diffDays === 0) return 'today';
  if (diffDays <= 3) return 'soon';
  return null;
}

function getDueRestaurants(){
  return state.restaurants.filter(r => {
    const s = dueStatus(r.proximaFecha);
    return s === 'overdue' || s === 'today';
  });
}

function diasDesdeUltimaVisita(r){
  const obs = r.observaciones || [];
  if (obs.length === 0) return null;
  const last = obs[0].fecha;
  const today = new Date();
  const lastDate = new Date(last);
  const diff = Math.floor((today - lastDate) / 86400000);
  return diff;
}

function getStaleRestaurants(){
  return state.restaurants
    .map(r => ({ r, dias: diasDesdeUltimaVisita(r) }))
    .filter(x => x.dias !== null && x.dias >= 30);
}

async function markContacted(id){
  const r = state.restaurants.find(x => x.id === id);
  if (!r) return;
  r.proximaFecha = "";
  r.proximaNota = "";
  await persist();
  render();
}

function tryNativeNotification(dueList){
  if (!("Notification" in window) || dueList.length === 0) return;
  dueList.forEach(r => {
    if (notifiedToday.has(r.id)) return;
    try {
      new Notification("Contacto pendiente: " + r.name, {
        body: r.proximaNota || "Tienes una reunión o contacto programado para hoy o antes."
      });
      notifiedToday.add(r.id);
    } catch (e) { /* silencioso: algunos navegadores/iframes no permiten notificaciones */ }
  });
}

function tryStaleNotification(staleList){
  if (!("Notification" in window) || staleList.length === 0) return;
  staleList.forEach(({r, dias}) => {
    if (notifiedStale.has(r.id)) return;
    try {
      new Notification("Sin seguimiento: " + r.name, {
        body: "Han pasado " + dias + " días desde la última visita registrada."
      });
      notifiedStale.add(r.id);
    } catch (e) { /* silencioso */ }
  });
}

function enableNotifications(){
  if (!("Notification" in window)){
    state.notifPermission = "unsupported";
    render();
    return;
  }
  Notification.requestPermission().then(p => {
    state.notifPermission = p;
    if (p === "granted"){
      tryNativeNotification(getDueRestaurants());
      tryStaleNotification(getStaleRestaurants());
    }
    render();
  }).catch(() => {
    state.notifPermission = "error";
    render();
  });
}

function startReminderPolling(){
  // Revisa cada 5 minutos mientras la pestaña esté abierta, y dispara
  // notificación nativa si el permiso ya está concedido.
  setInterval(() => {
    if ("Notification" in window && Notification.permission === "granted"){
      tryNativeNotification(getDueRestaurants());
      tryStaleNotification(getStaleRestaurants());
    }
  }, 5 * 60 * 1000);
}

function initMap(r){
  const el = document.getElementById('map-container');
  if (!el || !window.L) return;
  if (mapInstance){ mapInstance.remove(); mapInstance = null; }
  if (r.lat == null || r.lon == null) return;
  mapInstance = L.map('map-container', { zoomControl: false }).setView([r.lat, r.lon], 15);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap'
  }).addTo(mapInstance);
  L.marker([r.lat, r.lon]).addTo(mapInstance).bindPopup(escapeHtml(r.name));
}

function openAddModal(){ state.showAddModal = true; render(); }
function closeAddModal(){ state.showAddModal = false; render(); }

async function submitNewRestaurant(){
  const name = document.getElementById('modal-name').value.trim();
  const address = document.getElementById('modal-address').value.trim();
  const phone = document.getElementById('modal-phone').value.trim();
  if (!name) return;
  const newR = { id: uid(), name, address, phone, lat:null, lon:null, rut:"", ejecutivo:"", proximaFecha:"", proximaNota:"", observaciones:[] };
  state.restaurants.push(newR);
  state.selectedId = newR.id;
  state.showAddModal = false;
  await persist();
  render();
}

function escapeHtml(s){
  return (s || "").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function render(){
  const root = document.getElementById('root');
  if (!state.loaded){
    root.innerHTML = '<div class="load-msg">Cargando bitácora…</div>';
    return;
  }
  const filtered = state.restaurants.filter(r =>
    r.name.toLowerCase().includes(state.search.toLowerCase())
  ).sort((a,b) => a.name.localeCompare(b.name));

  const sel = getSelected();
  const dueList = getDueRestaurants();
  const staleList = getStaleRestaurants();
  const notifControlHtml = state.notifPermission !== "granted"
    ? `<button class="notif-enable-btn" id="enable-notif-btn">🔔 Activar notificaciones del navegador</button>`
    : `<span class="notif-status">🔔 Notificaciones activadas — se revisan cada 5 min mientras esta pestaña esté abierta</span>`;

  root.innerHTML = `
    ${dueList.length > 0 ? `
      <div class="notif-bar">
        <span class="notif-title">📅 ${dueList.length} contacto${dueList.length > 1 ? 's':''} pendiente${dueList.length > 1 ? 's':''} para hoy o antes</span>
        ${dueList.map(r => `
          <div class="notif-item">
            <span class="notif-item-text"><strong>${escapeHtml(r.name)}</strong> — ${escapeHtml(r.proximaNota || 'Contacto/reunión programada')} (${r.proximaFecha})</span>
            <button class="notif-done-btn" data-mark-id="${r.id}">Marcar contactado</button>
          </div>
        `).join('')}
        ${notifControlHtml}
      </div>` : ''}
    ${staleList.length > 0 ? `
      <div class="notif-bar stale">
        <span class="notif-title">⏳ ${staleList.length} local${staleList.length > 1 ? 'es':''} sin seguimiento hace 30 días o más</span>
        ${staleList.map(({r, dias}) => `
          <div class="notif-item">
            <span class="notif-item-text"><strong>${escapeHtml(r.name)}</strong> — última visita hace ${dias} días</span>
            <button class="notif-done-btn" data-select-id="${r.id}">Ver ficha</button>
          </div>
        `).join('')}
        ${dueList.length === 0 ? notifControlHtml : ''}
      </div>` : ''}
    <div class="app">
      <div class="sidebar">
        <p class="brand">Bitácora de restaurantes</p>
        <p class="brand-sub">Valdivia y alrededores</p>
        <input class="search" id="search-input" type="text" placeholder="Buscar restaurante…" value="${escapeHtml(state.search)}" />
        <button class="add-btn" id="open-add-modal">+ Agregar restaurante</button>
        <div class="list">
          <div class="list-count">${filtered.length} de ${state.restaurants.length} locales</div>
          ${filtered.map(r => {
            const done = r.rut && r.ejecutivo;
            const ds = dueStatus(r.proximaFecha);
            const dias = diasDesdeUltimaVisita(r);
            const isStale = dias !== null && dias >= 30;
            return `<div class="item ${r.id === state.selectedId ? 'active':''}" data-id="${r.id}">
              <span class="dot ${done ? 'done':'pending'}"></span>
              <span class="item-name">${escapeHtml(r.name)}</span>
              <span class="badge-group">
                ${ds ? `<span class="cal-badge ${ds}">${ds === 'overdue' ? 'vencido' : ds === 'today' ? 'hoy' : 'pronto'}</span>` : ''}
                ${isStale ? `<span class="stale-badge">⏳ ${dias} d sin visita</span>` : ''}
              </span>
            </div>`;
          }).join('')}
        </div>
      </div>
      <div class="main">
        ${sel ? renderDetail(sel) : `
          <div class="empty-state">
            <h2>Sin selección</h2>
            <p>Elige un restaurante de la lista o agrega uno nuevo para empezar a registrar RUT, ejecutivo asignado y observaciones de visita.</p>
          </div>`}
      </div>
    </div>
    ${state.showAddModal ? renderModal() : ''}
    ${state.showConfirmModal ? renderConfirmModal() : ''}
  `;

  attachEvents();
  if (sel) initMap(sel);
}

function renderDetail(r){
  const obs = r.observaciones || [];
  const lastVisit = obs[0];
  const diasStale = diasDesdeUltimaVisita(r);
  const isStale = diasStale !== null && diasStale >= 30;
  return `
    <h1 class="rname">${escapeHtml(r.name)}</h1>
    <div class="rmeta">
      ${r.address ? escapeHtml(r.address) : 'Sin dirección registrada'}${r.phone ? ' · ' + escapeHtml(r.phone) : ''}
    </div>

    ${lastVisit ? `
      <div class="visited-banner">
        <span>⚠</span>
        <span>Este local ya fue visitado por <strong>${escapeHtml(lastVisit.autor)}</strong> el ${fmtDate(lastVisit.fecha)}. Revisa la bitácora abajo antes de coordinar una nueva visita.</span>
      </div>` : ''}

    ${isStale ? `
      <div class="visited-banner">
        <span>⏳</span>
        <span>Han pasado <strong>${diasStale} días</strong> desde la última visita registrada. Este local lleva un tiempo sin seguimiento.</span>
      </div>` : ''}

    <span class="section-label">Ubicación</span>
    <div class="loc-row">
      <span class="as-note">${r.lat != null ? 'Coordenadas guardadas' : 'Sin coordenadas registradas'}</span>
      <button class="geo-btn" id="capture-loc-btn">Usar mi ubicación actual</button>
    </div>
    <div class="map-wrap">
      ${r.lat != null && r.lon != null ? '<div id="map-container"></div>' : '<div class="no-map">Sin ubicación en el mapa todavía. Usa el botón de arriba estando en el local.</div>'}
    </div>
    ${state.geoStatus ? `<div class="geo-status">${escapeHtml(state.geoStatus)}</div>` : ''}

    <span class="section-label">Próximo contacto o reunión</span>
    <div class="field-row">
      <div class="field">
        <label>Fecha</label>
        <input type="date" class="next-date-input" id="next-date-input" value="${escapeHtml(r.proximaFecha || '')}" />
      </div>
      <div class="field">
        <label>Motivo</label>
        <input type="text" class="rut-input" id="next-note-input" placeholder="Ej: reunión con el dueño / contactar representante legal" value="${escapeHtml(r.proximaNota || '')}" />
      </div>
    </div>
    <div class="next-contact-row">
      <span class="save-hint" id="next-save-hint-${r.id}"></span>
      ${r.proximaFecha ? `<button class="mark-done-btn" id="mark-contacted-btn">Marcar como contactado</button>` : ''}
    </div>

    <div class="field-row">
      <div class="field">
        <label>RUT</label>
        <input type="text" class="rut-input" id="rut-input" placeholder="Ej: 76.123.456-7" value="${escapeHtml(r.rut)}" />
      </div>
      <div class="field">
        <label>Ejecutivo asignado</label>
        <select class="exec-select" id="exec-select">
          <option value="">— Seleccionar —</option>
          ${EJECUTIVOS.map(e => `<option value="${e}" ${r.ejecutivo === e ? 'selected':''}>${e}</option>`).join('')}
        </select>
      </div>
    </div>
    <div class="save-hint" id="save-hint-${r.id}"></div>

    <span class="section-label">Observaciones</span>
    <div class="obs-list">
      ${obs.length === 0 ? '<div class="no-obs">Todavía no hay observaciones registradas.</div>' : obs.map(o => `
        <div class="obs-item">
          <div class="obs-date"><span class="obs-author">${escapeHtml(o.autor)}</span> — ${fmtDate(o.fecha)}</div>
          <div class="obs-text">${escapeHtml(o.texto)}</div>
        </div>
      `).join('')}
    </div>

    <span class="section-label">Nueva observación</span>
    <textarea class="new-obs" id="new-obs-text" placeholder="Ej: visitado el 08-09, interesado en Point Pro, esperando aprobación del dueño…"></textarea>
    <div class="obs-submit-row">
      <span class="as-note">Se registrará a nombre de: ${r.ejecutivo ? escapeHtml(r.ejecutivo) : 'sin asignar (elige un ejecutivo arriba)'}</span>
      <button class="btn-primary" id="add-obs-btn">Guardar observación</button>
    </div>
  `;
}

function renderConfirmModal(){
  return `
    <div class="modal-backdrop" id="confirm-backdrop">
      <div class="modal">
        <h3>Local ya visitado</h3>
        <p style="font-size:14px; line-height:1.5; margin-bottom:18px;">
          <strong>${escapeHtml(state.confirmLastAutor)}</strong> ya registró una visita a este local el ${fmtDate(state.confirmLastFecha)}. ¿Quieres agregar tu observación de todas formas?
        </p>
        <div class="modal-actions">
          <button class="btn-ghost" id="confirm-cancel">Cancelar</button>
          <button class="btn-primary" id="confirm-proceed">Registrar igual</button>
        </div>
      </div>
    </div>
  `;
}

function renderModal(){
  return `
    <div class="modal-backdrop" id="modal-backdrop">
      <div class="modal">
        <h3>Nuevo restaurante</h3>
        <input type="text" id="modal-name" placeholder="Nombre del restaurante" />
        <input type="text" id="modal-address" placeholder="Dirección (opcional)" />
        <input type="text" id="modal-phone" placeholder="Teléfono (opcional)" />
        <div class="modal-actions">
          <button class="btn-ghost" id="modal-cancel">Cancelar</button>
          <button class="btn-primary" id="modal-save">Agregar</button>
        </div>
      </div>
    </div>
  `;
}

function attachEvents(){
  const searchInput = document.getElementById('search-input');
  if (searchInput){
    searchInput.addEventListener('input', (e) => {
      state.search = e.target.value;
      render();
      document.getElementById('search-input').focus();
      document.getElementById('search-input').selectionStart = document.getElementById('search-input').value.length;
    });
  }

  document.querySelectorAll('.item').forEach(el => {
    el.addEventListener('click', () => selectRestaurant(el.dataset.id));
  });

  const addBtn = document.getElementById('open-add-modal');
  if (addBtn) addBtn.addEventListener('click', openAddModal);

  const rutInput = document.getElementById('rut-input');
  const execSelect = document.getElementById('exec-select');
  const sel = getSelected();
  if (rutInput && sel){
    rutInput.addEventListener('change', () => { updateField(sel.id, 'rut', rutInput.value.trim()); saveDetail(sel.id); });
  }
  if (execSelect && sel){
    execSelect.addEventListener('change', () => { updateField(sel.id, 'ejecutivo', execSelect.value); saveDetail(sel.id); render(); });
  }
  const addObsBtn = document.getElementById('add-obs-btn');
  if (addObsBtn && sel) addObsBtn.addEventListener('click', () => attemptAddObservation(sel.id));

  const geoBtn = document.getElementById('capture-loc-btn');
  if (geoBtn && sel) geoBtn.addEventListener('click', () => captureLocation(sel.id));

  const nextDateInput = document.getElementById('next-date-input');
  const nextNoteInput = document.getElementById('next-note-input');
  if (nextDateInput && sel){
    nextDateInput.addEventListener('change', () => { updateField(sel.id, 'proximaFecha', nextDateInput.value); saveNextContact(sel.id); });
  }
  if (nextNoteInput && sel){
    nextNoteInput.addEventListener('change', () => { updateField(sel.id, 'proximaNota', nextNoteInput.value.trim()); saveNextContact(sel.id); });
  }
  const markBtn = document.getElementById('mark-contacted-btn');
  if (markBtn && sel) markBtn.addEventListener('click', () => markContacted(sel.id));

  document.querySelectorAll('[data-mark-id]').forEach(btn => {
    btn.addEventListener('click', () => markContacted(btn.dataset.markId));
  });

  document.querySelectorAll('[data-select-id]').forEach(btn => {
    btn.addEventListener('click', () => selectRestaurant(btn.dataset.selectId));
  });

  const enableNotifBtn = document.getElementById('enable-notif-btn');
  if (enableNotifBtn) enableNotifBtn.addEventListener('click', enableNotifications);

  const backdrop = document.getElementById('modal-backdrop');
  if (backdrop){
    backdrop.addEventListener('click', (e) => { if (e.target === backdrop) closeAddModal(); });
  }
  const modalCancel = document.getElementById('modal-cancel');
  if (modalCancel) modalCancel.addEventListener('click', closeAddModal);
  const modalSave = document.getElementById('modal-save');
  if (modalSave) modalSave.addEventListener('click', submitNewRestaurant);

  const confirmBackdrop = document.getElementById('confirm-backdrop');
  if (confirmBackdrop){
    confirmBackdrop.addEventListener('click', (e) => { if (e.target === confirmBackdrop) confirmCancelAdd(); });
  }
  const confirmCancelBtn = document.getElementById('confirm-cancel');
  if (confirmCancelBtn) confirmCancelBtn.addEventListener('click', confirmCancelAdd);
  const confirmProceedBtn = document.getElementById('confirm-proceed');
  if (confirmProceedBtn) confirmProceedBtn.addEventListener('click', confirmAddAnyway);
}

loadData();
</script>
</body>
</html>
